PORT=4000
CORS_ORIGIN=http://localhost:5180

# Required — your MongoDB connection string (Atlas or local)
MONGODB_URI=

# ---------------------------------------------------------------------------
# Everything below is optional. The defaults cost nothing and need no account.
# ---------------------------------------------------------------------------

# Speech-to-text.  client = Whisper runs locally in the app on your own GPU.
#   client (default, free, offline)  |  whisper (paid key)  |  deepgram (paid key)
STT_PROVIDER=client
# OPENAI_API_KEY=
# DEEPGRAM_API_KEY=

# Capture parsing.  heuristic = rules only, no model, no network.
#   heuristic (default, free)  |  ollama (free, local model)  |  claude (paid key)
PARSER=heuristic
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b
# ANTHROPIC_API_KEY=
